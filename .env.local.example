# Copie ce fichier en .env.local et remplis avec les valeurs de ton projet Supabase
# (Project Settings > API). Sans ces deux lignes, le mode deux telephones fonctionne seulement
# entre deux onglets du meme navigateur (essai local).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
